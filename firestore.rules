rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: each document is identified by the user's Firebase Auth UID
    match /users/{userId} {

      // --- READ ---
      // A user can read their own document.
      // A teacher can read any student's document where:
      //   - student's teacherId == teacher's Firebase Auth UID, OR
      //   - student's teacherId == teacher's email (for backward compatibility)
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.teacherId == request.auth.token.email
      );

      // --- CREATE / UPDATE ---
      // A user can create or update their own document (userId must match their auth UID).
      // The document must include at minimum: uid, email, displayName, role, teacherId, createdAt.
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'teacherId', 'createdAt']);

      // --- DELETE ---
      // A user can delete only their own document.
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
